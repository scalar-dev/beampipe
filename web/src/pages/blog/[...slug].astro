---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const formattedDate = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={post.data.title}>
  <main class="mx-auto max-w-3xl px-4 pt-12 pb-20 sm:px-6 md:pt-16">
    <a
      href="/blog"
      class="text-sm font-semibold text-gray-500 hover:text-gray-900"
    >
      <span aria-hidden="true">←</span> All posts
    </a>
    <article class="mt-8">
      <header>
        <p class="text-sm text-gray-500">
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time> · {post.data.author}
        </p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          {post.data.title}
        </h1>
      </header>
      <div class="prose mt-10 max-w-none text-lg leading-8 text-gray-700">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5,
  .prose h6 {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #111827;
    line-height: 1.25;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .prose ul,
  .prose ol {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .prose a {
    font-weight: 600;
    color: var(--color-green-700);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose a:hover {
    color: var(--color-green-600);
  }

  .prose img {
    border-radius: 0.75rem;
  }

  .prose code {
    font-size: 0.875em;
    background: var(--color-gray-100);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
  }

  .prose pre {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .prose pre code {
    background: none;
    padding: 0;
  }

  .prose img {
    margin-left: auto;
    margin-right: auto;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }

  .prose hr {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    border-color: #e5e7eb;
  }

  .prose strong {
    font-weight: 700;
  }
</style>
