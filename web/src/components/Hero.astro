---
import Screenshot from "./Screenshot.astro";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.beampipe.io";
---

<section class="relative isolate overflow-hidden">
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[36rem] bg-[radial-gradient(60%_60%_at_50%_0%,var(--color-green-50),transparent)]"
  >
  </div>

  <div class="mx-auto max-w-6xl px-4 pt-16 pb-16 text-center sm:px-6 md:pt-24 md:pb-24">
    <p
      class="inline-flex items-center gap-2 rounded-full bg-white px-3 py-1 text-sm font-medium text-gray-700 ring-1 ring-gray-200"
    >
      <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
      Free for up to 10k monthly page views
    </p>

    <h1
      class="mt-6 text-5xl font-extrabold tracking-tight text-gray-900 sm:text-6xl md:text-7xl"
    >
      Simple. Powerful. <span class="text-green-600">Private.</span>
    </h1>

    <p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600 md:text-xl">
      beampipe is simple, privacy-focussed web analytics. No cookies, no
      personal identifiers. Just the numbers you need.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href={`${appUrl}/sign-up`}
        class="w-full rounded-lg bg-green-600 px-6 py-3 text-base font-semibold text-white shadow-sm transition-colors hover:bg-green-500 sm:w-auto"
      >
        Sign up free
      </a>
      <a
        href={`${appUrl}/domain/beampipe.io`}
        class="w-full rounded-lg bg-white px-6 py-3 text-base font-semibold text-gray-900 shadow-sm ring-1 ring-gray-300 transition-colors hover:bg-gray-50 sm:w-auto"
      >
        View live demo <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mx-auto mt-16 max-w-5xl md:mt-20">
      <Screenshot>
        <video
          class="h-auto"
          width="2484"
          height="1471"
          loop
          autoplay
          muted
          playsinline
          preload="auto"
          poster="/images/screenshot.png"
        >
          <source type="video/mp4" src="/video.mp4" />
        </video>
      </Screenshot>
    </div>
  </div>
</section>
