---
import { BrandMark } from "@beampipe/components";
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.beampipe.io";

const links = [
  { href: "/#pricing", label: "Pricing", pricing: true },
  { href: "/blog", label: "Blog" },
  { href: "https://docs.beampipe.io", label: "Docs", external: true },
];
---

<header
  class="sticky top-0 z-40 border-b border-gray-200/70 bg-white/80 backdrop-blur"
>
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <div class="flex items-center gap-10">
      <BrandMark href="/" />

      <div class="hidden items-center gap-7 md:flex">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm font-medium text-gray-600 transition-colors hover:text-gray-900"
              data-pricing-link={link.pricing ? "" : undefined}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <div class="hidden items-center gap-5 md:flex">
      <a
        href={`${appUrl}/sign-in`}
        class="text-sm font-medium text-gray-600 transition-colors hover:text-gray-900"
      >
        Log in
      </a>
      <a
        href={`${appUrl}/sign-up`}
        class="rounded-lg bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-green-500"
      >
        Sign up free
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="-mr-2 rounded-md p-2 text-gray-600 hover:bg-gray-100 hover:text-gray-900 md:hidden"
      aria-controls="menu"
      aria-expanded="false"
    >
      <span class="sr-only">Toggle menu</span>
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </nav>

  <div id="menu" class="hidden border-t border-gray-200 bg-white md:hidden">
    <div class="space-y-1 px-4 py-3">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="block rounded-md px-3 py-2 text-base font-medium text-gray-700 hover:bg-gray-50"
            data-pricing-link={link.pricing ? "" : undefined}
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noreferrer" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </div>
    <div class="flex items-center gap-3 border-t border-gray-100 px-4 py-4">
      <a
        href={`${appUrl}/sign-in`}
        class="flex-1 rounded-lg px-4 py-2.5 text-center text-sm font-semibold text-gray-700 ring-1 ring-gray-300 hover:bg-gray-50"
      >
        Log in
      </a>
      <a
        href={`${appUrl}/sign-up`}
        class="flex-1 rounded-lg bg-green-600 px-4 py-2.5 text-center text-sm font-semibold text-white hover:bg-green-500"
      >
        Sign up free
      </a>
    </div>
  </div>
</header>

<script is:inline>
  var toggle = document.getElementById("menu-toggle");
  var menu = document.getElementById("menu");

  toggle.addEventListener("click", function () {
    var hidden = menu.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!hidden));
  });

  document.querySelectorAll("[data-pricing-link]").forEach(function (link) {
    link.addEventListener("click", function () {
      menu.classList.add("hidden");
      toggle.setAttribute("aria-expanded", "false");
      if (typeof window.beampipe === "function") {
        window.beampipe("view_pricing");
      }
    });
  });
</script>
