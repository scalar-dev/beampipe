---
const appUrl = import.meta.env.PUBLIC_APP_URL || "https://app.beampipe.io";
---

<section class="px-4 py-20 sm:px-6 md:py-28">
  <div
    class="mx-auto max-w-5xl overflow-hidden rounded-3xl bg-green-600 px-6 py-16 text-center shadow-xl shadow-green-900/10 sm:px-16"
  >
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
      Take back control of your analytics.
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-green-50">
      Get set up in minutes with a single snippet. Free for up to 10k monthly
      page views.
    </p>
    <div class="mt-8">
      <a
        href={`${appUrl}/sign-up`}
        class="inline-block rounded-lg bg-white px-6 py-3 text-base font-semibold text-green-700 shadow-sm transition-colors hover:bg-green-50"
      >
        Get started
      </a>
    </div>
  </div>
</section>
