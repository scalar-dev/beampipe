---
import { Logo } from "@beampipe/components";
import { SCALAR_CONTACT_URL, SCALAR_URL } from "../scalar";

const links = [
  { href: "/blog", label: "Blog" },
  { href: "https://docs.beampipe.io/", label: "Docs", external: true },
  { href: "/privacy", label: "Privacy policy" },
  { href: "mailto:hello@beampipe.io", label: "Contact us" },
];

const social = [
  { href: "https://www.producthunt.com/posts/beampipe", label: "Product Hunt", path: "M13.604 8.4h-3.405V12h3.405c.995 0 1.801-.806 1.801-1.801 0-.993-.806-1.799-1.801-1.799zM12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zm1.604 14.4h-3.405V18H7.801V6h5.804c2.319 0 4.2 1.88 4.2 4.199 0 2.321-1.881 4.201-4.201 4.201z" },
  { href: "https://github.com/scalar-dev/beampipe", label: "GitHub", path: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" },
];
---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <a href="/" class="text-xl font-extrabold tracking-tight text-green-600 hover:text-green-500">
          <Logo />
        </a>
        <p class="mt-3 max-w-sm text-sm text-gray-600">
          Built by <a href={SCALAR_URL} class="font-semibold text-gray-900 hover:text-green-600" data-scalar-link>Scalar</a>.
          We build AI systems to help you scale.
        </p>
        <a
          href={SCALAR_CONTACT_URL}
          class="mt-3 inline-flex text-sm font-semibold text-green-600 hover:text-green-500"
          data-scalar-link
        >
          Work with us <span aria-hidden="true" class="ml-1">→</span>
        </a>
      </div>

      <nav class="flex flex-wrap gap-x-8 gap-y-3">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="text-sm text-gray-600 hover:text-gray-900"
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-10 flex flex-col-reverse gap-6 border-t border-gray-100 pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-gray-500">&copy; {new Date().getFullYear()} Beampipe.</p>
      <div class="flex gap-5">
        {
          social.map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer" class="text-gray-400 hover:text-gray-600">
              <span class="sr-only">{item.label}</span>
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={item.path} />
              </svg>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
